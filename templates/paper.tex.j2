\#{ ---- Disclosure layer --------------------------------------------------
    The document is meant to look real, so the marking has to survive the way
    it actually gets shared: a screenshot of one page, often just the abstract.
    Anything that lives only at the top or bottom of page 1 is gone by then.

    "subtle" (default) puts the disclosure where a real preprint already keeps
    its status notes -- running header, title footnote, and the front-matter
    statements before the references. It reads as formatting, not as a stamp.
    "loud" adds the diagonal watermark and the boxed banner on top. }

\renewcommand{\headeright}{\BLOCK{if spec.disclosure == "loud"}Satire --- Not a Real Paper\BLOCK{else}Satirical Preprint\BLOCK{endif}}
\renewcommand{\undertitle}{A Satirical Preprint}
\#{ arxiv.sty defaults the centre header to the full title, which collides with
    the right header on anything but a very short one. }
\renewcommand{\shorttitle}{\VAR{spec.short_title}}

\BLOCK{if spec.disclosure == "loud"}
\SetWatermarkText{SATIRE}
\SetWatermarkScale{1.15}
\SetWatermarkColor[gray]{0.91}
\BLOCK{else}
\SetWatermarkText{}
\BLOCK{endif}

\newcommand{\satirefoot}{%
  \begin{minipage}{\textwidth}
    \centering
    \thepage\\[2pt]
    {\scriptsize\color{satire}\textsc{Satire --- AI-generated fiction. The data, citations and findings are fabricated.}}
  \end{minipage}%
}

\renewcommand{\footrulewidth}{0.4pt}
\fancyfoot[C]{\satirefoot}

\#{ Page 1 carries the footer band but no running head -- a title page with a
    header on it is the kind of detail that reads as wrong. }
\fancypagestyle{satirefirst}{%
  \fancyhf{}%
  \renewcommand{\headrulewidth}{0pt}%
  \renewcommand{\footrulewidth}{0.4pt}%
  \fancyfoot[C]{\satirefoot}%
}

\#{ The stamp arXiv itself prints down the left edge of page 1. Drawn into the
    page background via eso-pic so it costs zero layout space. The ID carries an
    impossible month (enforced in schema.py) so it can never resolve. }
\newcommand{\arxivstamp}[1]{%
  \AddToShipoutPictureBG*{%
    \AtPageLowerLeft{\raisebox{2.05in}{\hspace{0.34in}\rotatebox{90}{\footnotesize #1}}}%
  }%
}

\newcommand{\satirebanner}{%
  \begin{center}
    \setlength{\fboxsep}{7pt}%
    \fcolorbox{satire}{satirebg}{%
      \begin{minipage}{0.92\textwidth}
        \centering\small
        \textbf{\textsc{Satirical preprint --- this is not a real research paper}}\\[3pt]
        Generated by \textsc{Rhetoric-AI} to settle an argument. The authors,
        affiliations, dataset, statistics, figures and every reference listed
        below are fabricated. Nothing here is evidence of anything. Do not cite it.
      \end{minipage}%
    }%
  \end{center}%
  \vspace{0.15in}%
}

\#{ The dagger footnote is where real preprints put "Under review, do not
    distribute". Putting the disclosure there makes it read as authentic
    formatting while stating plainly what the document is. }
\title{\VAR{spec.title}\thanks{%
  \textbf{This paper is satire.} It was generated by \textsc{Rhetoric-AI} from
  the one-line claim ``\VAR{spec.claim}''. The authors and their affiliations
  are invented, no study was conducted, and every reference is fabricated.
  See the Disclaimer on the final page.}}
\date{\VAR{spec.date}}

\author{%
\BLOCK{for a in spec.authors}
  \textbf{\VAR{a.name}}\\
  \VAR{a.affiliation}%
  \BLOCK{if a.email}\\ \texttt{\VAR{a.email}}\BLOCK{endif}
  \BLOCK{if not loop.last}\And\BLOCK{endif}
\BLOCK{endfor}
}

\begin{document}
\newgeometry{textheight=9in, textwidth=6.5in, top=1in, headheight=14pt, headsep=25pt, footskip=46pt}

\arxivstamp{\VAR{spec.stamp}}
\BLOCK{if spec.disclosure == "loud"}
\satirebanner
\BLOCK{endif}
\maketitle
\thispagestyle{satirefirst}

\begin{abstract}
\VAR{spec.abstract|body}
\end{abstract}

\keywords{\BLOCK{for k in spec.keywords}\VAR{k}\BLOCK{if not loop.last} \and \BLOCK{endif}\BLOCK{endfor}}

\BLOCK{for s in spec.sections}
\section{\VAR{s.heading}}
\BLOCK{for p in s.paragraphs}
\VAR{p|body}

\BLOCK{endfor}
\BLOCK{if s.figure}
\begin{figure}[htbp]
  \centering
  \includegraphics[width=0.78\textwidth]{\VAR{s.figure.label|ident}.png}
  \caption{\VAR{s.figure.caption|body}}
  \label{fig:\VAR{s.figure.label|ident}}
\end{figure}
\BLOCK{endif}
\BLOCK{endfor}

\#{ Real papers carry these three statements just before the references, so
